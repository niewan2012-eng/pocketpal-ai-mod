+  /**
+   * DIAG: the Hexagon backend reads ~25 GGML_HEXAGON_* knobs from the environment
+   * when the DSP session starts, which an app cannot otherwise influence without
+   * a rebuild. Read them from an app-external file so a single build can be
+   * A/B-tested:
+   *
+   *   adb push rnllama.env /sdcard/Android/data/com.pocketpalai.mod/files/
+   *   adb shell am force-stop com.pocketpalai.mod   # applies on next start
+   *
+   * One KEY=VALUE per line, '#' comments. Only GGML_HEXAGON_/ADSP_/RNLLAMA_ keys.
+   */
+  private static void applyEnvOverrides(ReactApplicationContext context) {
+    File dir = context.getExternalFilesDir(null);
+    if (dir == null) {
+      return;
+    }
+    File file = new File(dir, "rnllama.env");
+    if (!file.isFile()) {
+      return;
+    }
+    Log.d(TAG, "[diag] reading env overrides from " + file.getAbsolutePath());
+    try (BufferedReader reader = new BufferedReader(new FileReader(file))) {
+      String line;
+      while ((line = reader.readLine()) != null) {
+        line = line.trim();
+        if (line.isEmpty() || line.charAt(0) == '#') {
+          continue;
+        }
+        int eq = line.indexOf('=');
+        if (eq <= 0) {
+          continue;
+        }
+        String key = line.substring(0, eq).trim();
+        String value = line.substring(eq + 1).trim();
+        if (!key.matches("^(?:GGML_HEXAGON_|ADSP_|RNLLAMA_)[A-Z0-9_]+$")) {
+          Log.w(TAG, "[diag] ignoring env override for " + key);
+          continue;
+        }
+        try {
+          android.system.Os.setenv(key, value, true);
+          Log.d(TAG, "[diag] env " + key + "=" + value);
+        } catch (Exception e) {
+          Log.w(TAG, "[diag] failed to set env " + key, e);
+        }
+      }
+    } catch (Exception e) {
+      Log.w(TAG, "[diag] failed to read " + file.getAbsolutePath(), e);
+    }
+  }
+
